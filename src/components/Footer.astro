---
---
<footer class="bg-offway-black border-t border-white/10 pt-16 pb-8 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      
      <!-- Column 1: Brand details -->
      <div class="flex flex-col space-y-4">
        <h2 class="font-heading font-extrabold text-3xl tracking-wider text-white">
          OFF <span class="text-offway-blue">WAY</span>
        </h2>
        <p class="text-white/60 text-sm max-w-xs">
          Engineered streetwear and accessories inspired by underground skate and hip-hop subcultures. Crafted for individuals who make their own way.
        </p>
        <div class="pt-2 text-xs font-mono text-white/40">
          <p>Authentic Streetwear Co.</p>
          <p>© 2026 OFF WAY. All Rights Reserved.</p>
        </div>
      </div>

      <!-- Column 2: Navigation Links -->
      <div>
        <h3 class="font-heading font-bold text-xs uppercase tracking-widest text-white mb-6">Collections</h3>
        <ul class="space-y-3 text-sm text-white/60 font-semibold">
          <li><a href="#shop" class="hover:text-offway-blue transition-colors">New Drops</a></li>
          <li><a href="#caps" class="hover:text-offway-blue transition-colors">Signature Caps</a></li>
          <li><a href="#streetwear" class="hover:text-offway-blue transition-colors">Apparel & Tees</a></li>
          <li><a href="#accessories" class="hover:text-offway-blue transition-colors">Tactical Accessories</a></li>
        </ul>
      </div>

      <!-- Column 3: Contact & Support (Authentic Hostinger Channels) -->
      <div>
        <h3 class="font-heading font-bold text-xs uppercase tracking-widest text-white mb-6">Support Channels</h3>
        <ul class="space-y-3 text-sm text-white/60 font-mono">
          <li>
            <span class="block text-[10px] text-white/30 tracking-widest uppercase">Customer Service</span>
            <a href="mailto:offway.store.in@outlook.com" class="hover:text-offway-blue transition-colors text-white/80 font-bold">offway.store.in@outlook.com</a>
          </li>
          <li>
            <span class="block text-[10px] text-white/30 tracking-widest uppercase">Inquiries & Press</span>
            <a href="mailto:offway.store.in@gmail.com" class="hover:text-offway-blue transition-colors text-white/80 font-bold">offway.store.in@gmail.com</a>
          </li>
          <li class="pt-2">
            <span class="inline-block px-2.5 py-1 text-[10px] uppercase font-bold tracking-widest bg-offway-blue/15 text-offway-blue border border-offway-blue/20">
              COD Available in India
            </span>
          </li>
        </ul>
      </div>

      <!-- Column 4: Newsletter Signup -->
      <div>
        <h3 class="font-heading font-bold text-xs uppercase tracking-widest text-white mb-6 font-semibold">Join the Syndicate</h3>
        <p class="text-white/60 text-sm mb-4">
          Subscribe to receive notifications for limited edition capsule drops and private releases.
        </p>
        <form class="space-y-3" onsubmit="event.preventDefault(); alert('Subscribed to the syndicate!');">
          <div class="relative">
            <input 
              type="email" 
              placeholder="ENTER EMAIL" 
              required
              class="w-full bg-offway-card border border-white/10 px-4 py-3 text-sm text-white font-mono placeholder-white/30 focus:outline-none focus:border-offway-blue focus:ring-1 focus:ring-offway-blue transition-all"
            />
          </div>
          <button 
            type="submit" 
            class="w-full bg-offway-blue text-white font-heading font-bold uppercase py-3 tracking-widest text-xs transition-all hover:bg-white hover:text-offway-black shadow-md cursor-pointer"
          >
            SUBSCRIBE
          </button>
        </form>
      </div>

    </div>

    <!-- Bottom border & Payment indicators -->
    <div class="border-t border-white/5 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center space-x-6 text-xs text-white/40 font-semibold uppercase tracking-wider">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
        <a href="#" class="hover:text-white transition-colors">Refunds & Returns</a>
      </div>
      
      <!-- Payment Badges (Clean Vector/SVG representation) -->
      <div class="flex items-center space-x-4 opacity-50">
        <span class="text-[10px] font-mono tracking-widest text-white/60 uppercase">Secure Payments</span>
        <div class="flex space-x-2">
          <!-- UPI/Card indicators -->
          <div class="h-6 w-9 rounded bg-offway-card border border-white/10 flex items-center justify-center text-[8px] font-extrabold tracking-tight font-mono text-white/80">UPI</div>
          <div class="h-6 w-9 rounded bg-offway-card border border-white/10 flex items-center justify-center text-[8px] font-extrabold tracking-tight font-mono text-white/80">CARD</div>
          <div class="h-6 w-9 rounded bg-offway-card border border-white/10 flex items-center justify-center text-[8px] font-extrabold tracking-tight font-mono text-white/80">COD</div>
        </div>
      </div>
    </div>

  </div>
</footer>
