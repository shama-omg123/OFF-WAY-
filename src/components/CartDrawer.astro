---
---

<div id="cart-drawer-backdrop" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden transition-opacity duration-300 opacity-0"></div>

<div id="cart-drawer" class="fixed top-0 right-0 h-full w-full sm:w-[420px] bg-offway-black border-l border-white/10 shadow-2xl z-50 transform translate-x-full transition-transform duration-300 flex flex-col justify-between overflow-hidden">
  
  <!-- Cart Header -->
  <div class="p-6 border-b border-white/10 flex items-center justify-between bg-black/50">
    <div class="flex items-center space-x-3">
      <svg class="w-6 h-6 text-offway-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
      <h2 class="font-heading font-extrabold text-xl tracking-wider text-white uppercase">YOUR BAG (<span id="cart-count-title">0</span>)</h2>
    </div>
    <button id="cart-close-btn" class="text-white/60 hover:text-white bg-white/5 hover:bg-white/15 p-2 rounded-full transition-colors cursor-pointer">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Cart Items List Container -->
  <div id="cart-items-container" class="flex-grow overflow-y-auto p-6 space-y-4 divide-y divide-white/5">
    <!-- Items rendered dynamically via JS -->
  </div>

  <!-- Empty Cart State (Hidden when items present) -->
  <div id="cart-empty-state" class="hidden flex-col items-center justify-center p-8 text-center flex-grow">
    <div class="w-16 h-16 rounded-full bg-white/5 flex items-center justify-center mb-4 text-white/30">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
    </div>
    <h3 class="font-heading font-bold text-lg text-white mb-1">YOUR BAG IS EMPTY</h3>
    <p class="text-xs text-white/50 mb-6">Looks like you haven't added any products yet.</p>
    <button id="start-shopping-btn" class="bg-offway-blue text-white font-heading text-xs font-bold uppercase tracking-widest px-6 py-3 hover:bg-white hover:text-black transition-colors">
      EXPLORE CATALOG
    </button>
  </div>

  <!-- Cart Footer / Checkout -->
  <div id="cart-footer" class="p-6 border-t border-white/10 bg-black/60 space-y-4">
    <div class="space-y-2">
      <div class="flex justify-between text-xs text-white/60 font-mono">
        <span>Subtotal</span>
        <span id="cart-subtotal" class="font-bold text-white">₹0</span>
      </div>
      <div class="flex justify-between text-xs text-white/60 font-mono">
        <span>Delivery</span>
        <span class="text-offway-blue font-bold">FREE / COD AVAILABLE</span>
      </div>
      <div class="border-t border-white/10 pt-2 flex justify-between text-base font-heading font-extrabold text-white">
        <span>TOTAL</span>
        <span id="cart-total" class="text-offway-blue">₹0</span>
      </div>
    </div>

    <button 
      id="whatsapp-checkout-btn"
      class="w-full bg-[#25D366] text-black font-heading font-bold uppercase py-4 tracking-widest text-xs transition-all hover:bg-white hover:text-black shadow-lg flex items-center justify-center space-x-2 cursor-pointer"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
      <span>ORDER VIA WHATSAPP</span>
    </button>
  </div>
</div>

<script is:inline>
  // Global Cart Store Manager
  window.OffwayCart = {
    getCart() {
      try {
        const data = localStorage.getItem('offway_cart');
        return data ? JSON.parse(data) : [];
      } catch (e) {
        return [];
      }
    },

    saveCart(items) {
      localStorage.setItem('offway_cart', JSON.stringify(items));
      window.dispatchEvent(new CustomEvent('offway-cart-updated', { detail: items }));
    },

    addItem(product) {
      const cart = this.getCart();
      const itemKey = `${product.id}-${product.size}`;
      const existing = cart.find(i => i.key === itemKey);

      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({
          key: itemKey,
          id: product.id,
          title: product.title,
          price: product.price,
          imageSrc: product.imageSrc,
          size: product.size,
          quantity: 1
        });
      }
      this.saveCart(cart);
      this.openDrawer();
    },

    updateQuantity(key, delta) {
      let cart = this.getCart();
      const item = cart.find(i => i.key === key);
      if (item) {
        item.quantity += delta;
        if (item.quantity <= 0) {
          cart = cart.filter(i => i.key !== key);
        }
        this.saveCart(cart);
      }
    },

    removeItem(key) {
      let cart = this.getCart();
      cart = cart.filter(i => i.key !== key);
      this.saveCart(cart);
    },

    openDrawer() {
      const drawer = document.getElementById('cart-drawer');
      const backdrop = document.getElementById('cart-drawer-backdrop');
      if (drawer && backdrop) {
        backdrop.classList.remove('hidden');
        setTimeout(() => {
          backdrop.classList.remove('opacity-0');
          backdrop.classList.add('opacity-100');
          drawer.classList.remove('translate-x-full');
        }, 10);
      }
    },

    closeDrawer() {
      const drawer = document.getElementById('cart-drawer');
      const backdrop = document.getElementById('cart-drawer-backdrop');
      if (drawer && backdrop) {
        drawer.classList.add('translate-x-full');
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0');
        setTimeout(() => {
          backdrop.classList.add('hidden');
        }, 300);
      }
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    const backdrop = document.getElementById('cart-drawer-backdrop');
    const closeBtn = document.getElementById('cart-close-btn');
    const itemsContainer = document.getElementById('cart-items-container');
    const emptyState = document.getElementById('cart-empty-state');
    const footer = document.getElementById('cart-footer');
    const subtotalEl = document.getElementById('cart-subtotal');
    const totalEl = document.getElementById('cart-total');
    const countTitle = document.getElementById('cart-count-title');
    const checkoutBtn = document.getElementById('whatsapp-checkout-btn');
    const startShopBtn = document.getElementById('start-shopping-btn');

    if (backdrop) backdrop.addEventListener('click', () => window.OffwayCart.closeDrawer());
    if (closeBtn) closeBtn.addEventListener('click', () => window.OffwayCart.closeDrawer());
    if (startShopBtn) {
      startShopBtn.addEventListener('click', () => {
        window.OffwayCart.closeDrawer();
        const shopSec = document.getElementById('shop');
        if (shopSec) shopSec.scrollIntoView({ behavior: 'smooth' });
      });
    }

    function renderCartUI(cart) {
      const totalItems = cart.reduce((sum, i) => sum + i.quantity, 0);
      const grandTotal = cart.reduce((sum, i) => sum + (i.price * i.quantity), 0);

      // Update Header counts
      const countBadges = document.querySelectorAll('.snipcart-items-count');
      const priceBadges = document.querySelectorAll('.snipcart-total-price');

      countBadges.forEach(b => b.textContent = totalItems.toString());
      priceBadges.forEach(p => p.textContent = `₹${grandTotal}`);

      if (countTitle) countTitle.textContent = totalItems.toString();
      if (subtotalEl) subtotalEl.textContent = `₹${grandTotal}`;
      if (totalEl) totalEl.textContent = `₹${grandTotal}`;

      if (cart.length === 0) {
        if (itemsContainer) itemsContainer.classList.add('hidden');
        if (footer) footer.classList.add('hidden');
        if (emptyState) emptyState.classList.remove('hidden');
        if (emptyState) emptyState.classList.add('flex');
        return;
      }

      if (itemsContainer) itemsContainer.classList.remove('hidden');
      if (footer) footer.classList.remove('hidden');
      if (emptyState) emptyState.classList.add('hidden');
      if (emptyState) emptyState.classList.remove('flex');

      if (itemsContainer) {
        itemsContainer.innerHTML = cart.map(item => `
          <div class="pt-4 first:pt-0 flex items-center justify-between gap-4">
            <div class="w-16 h-16 bg-[#0D0D0D] border border-white/10 shrink-0 overflow-hidden">
              <img src="${item.imageSrc}" alt="${item.title}" class="w-full h-full object-cover" />
            </div>
            <div class="flex-grow">
              <h4 class="font-heading font-bold text-xs text-white uppercase tracking-wider line-clamp-1">${item.title}</h4>
              <p class="text-[10px] font-mono text-white/50 uppercase mt-0.5">SIZE: <span class="text-offway-blue font-bold">${item.size}</span></p>
              <div class="flex items-center justify-between mt-2">
                <span class="font-heading font-extrabold text-sm text-white">₹${item.price * item.quantity}</span>
                <div class="flex items-center border border-white/10 rounded overflow-hidden bg-black">
                  <button onclick="window.OffwayCart.updateQuantity('${item.key}', -1)" class="px-2 py-0.5 text-xs text-white/60 hover:text-white hover:bg-white/10 cursor-pointer">-</button>
                  <span class="px-2 text-xs font-mono text-white">${item.quantity}</span>
                  <button onclick="window.OffwayCart.updateQuantity('${item.key}', 1)" class="px-2 py-0.5 text-xs text-white/60 hover:text-white hover:bg-white/10 cursor-pointer">+</button>
                </div>
              </div>
            </div>
            <button onclick="window.OffwayCart.removeItem('${item.key}')" class="text-white/30 hover:text-red-500 transition-colors p-1 cursor-pointer" title="Remove item">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        `).join('');
      }
    }

    // Checkout via WhatsApp
    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', () => {
        const cart = window.OffwayCart.getCart();
        if (cart.length === 0) return;

        const grandTotal = cart.reduce((sum, i) => sum + (i.price * i.quantity), 0);
        
        let message = `🔥 NEW ORDER FROM OFF-WAY STORE 🔥\n`;
        message += `---------------------------------\n`;
        cart.forEach((item, index) => {
          message += `${index + 1}. ${item.title}\n   • Size: ${item.size}\n   • Price: ₹${item.price} x ${item.quantity} = ₹${item.price * item.quantity}\n\n`;
        });
        message += `---------------------------------\n`;
        message += `💰 TOTAL AMOUNT: ₹${grandTotal}\n`;
        message += `🚚 Delivery: FREE / COD\n\n`;
        message += `Please confirm my order & send payment / COD details!`;

        const waUrl = `https://wa.me/918714415090?text=${encodeURIComponent(message)}`;
        window.open(waUrl, '_blank');
      });
    }

    // Initial render & Listener for cart updates
    renderCartUI(window.OffwayCart.getCart());
    window.addEventListener('offway-cart-updated', (e) => {
      renderCartUI(e.detail);
    });
  });
</script>
