---
interface Props {
  id: string;
  title: string;
  price: number;
  category: string;
  imageSrc: string;
  isNew?: boolean;
  isLimited?: boolean;
  description?: string;
  sizes?: { [key: string]: boolean }; // e.g. { S: true, M: true, L: false, XL: true }
  additionalImages?: string[];
}

const { 
  id, 
  title, 
  price, 
  category, 
  imageSrc, 
  isNew = false, 
  isLimited = false,
  description,
  sizes = { S: true, M: true, L: true, XL: true },
  additionalImages = []
} = Astro.props;

const allImages = [imageSrc, ...additionalImages];

// Determine first available size to set as default value
const availableSizes = Object.keys(sizes).filter(size => sizes[size]);
const defaultSize = availableSizes.length > 0 ? availableSizes[0] : "";
---

<div class="group relative border border-white/5 bg-offway-card p-4 transition-all duration-300 hover:border-offway-blue/50 flex flex-col justify-between h-full" data-product-card id={`card-${id}`}>
  <div class="flex-grow flex flex-col">
    <!-- Image Showcase Container -->
    <div class="relative overflow-hidden aspect-square bg-[#0D0D0D] mb-4 border border-white/5 shrink-0">
      <!-- Status Badges -->
      <div class="absolute top-3 left-3 z-20 flex flex-col gap-1.5">
        {isNew && (
          <span class="bg-offway-blue text-white font-heading text-[10px] uppercase px-2.5 py-1 font-bold tracking-widest shadow-md">
            NEW DROP
          </span>
        )}
        {isLimited && (
          <span class="bg-white text-offway-black font-heading text-[10px] uppercase px-2.5 py-1 font-bold tracking-widest shadow-md">
            LIMITED
          </span>
        )}
        {availableSizes.length === 0 && (
          <span class="bg-red-600 text-white font-heading text-[10px] uppercase px-2.5 py-1 font-bold tracking-widest shadow-md">
            OUT OF STOCK
          </span>
        )}
      </div>

      <!-- Product Image with zoom transition -->
      <button 
        type="button" 
        class="absolute inset-0 w-full h-full cursor-zoom-in z-10 group" 
        data-lightbox-trigger 
        data-images={JSON.stringify(allImages)}
        aria-label={`View images for ${title}`}
      >
        <div class="absolute inset-0 bg-offway-blue/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
        <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <div class="bg-black/50 backdrop-blur-sm text-white p-2 rounded-full transform translate-y-4 group-hover:translate-y-0 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" /></svg>
          </div>
        </div>
      </button>
      <img 
        src={imageSrc} 
        alt={title} 
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" 
      />
    </div>

    <!-- Product Text Details -->
    <div class="flex justify-between items-start mb-2">
      <div class="flex-1 pr-2">
        <p class="text-white/40 text-[10px] font-mono tracking-widest uppercase">{category}</p>
        <h3 class="font-heading font-bold text-base text-white mt-1 tracking-wide group-hover:text-offway-blue transition-colors duration-200 line-clamp-2 min-h-[2.75rem] flex items-center">
          {title}
        </h3>
        <p class="text-white/60 text-xs mt-1 font-medium line-clamp-2 leading-relaxed min-h-[2rem]">
          {description || '\u00A0'}
        </p>
      </div>
      <div class="text-right shrink-0">
        <span class="font-heading font-extrabold text-white text-lg block">
          ₹{price}
        </span>
      </div>
    </div>

    <!-- Size Variants Chips -->
    <div class="mt-auto pt-3">
      <p class="text-[10px] font-mono tracking-widest uppercase text-white/40 mb-2">Select Size</p>
      <div class="flex gap-2 flex-wrap" data-size-container>
        {Object.entries(sizes).map(([size, inStock]) => {
          const isSelected = size === defaultSize;
          return inStock ? (
            <button
              type="button"
              data-size={size}
              class={`w-10 h-10 border text-xs font-mono font-bold tracking-wider flex items-center justify-center transition-all duration-200 cursor-pointer ${
                isSelected 
                  ? 'border-offway-blue bg-offway-blue text-white shadow-[0_0_10px_rgba(0,71,205,0.4)]' 
                  : 'border-white/10 hover:border-white text-white/80 hover:text-white'
              }`}
            >
              {size}
            </button>
          ) : (
            <div
              title="Out of stock"
              class="w-10 h-10 border border-white/5 text-white/20 text-xs font-mono font-bold tracking-wider flex items-center justify-center diagonal-strike opacity-30 select-none cursor-not-allowed"
            >
              {size}
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Add to Cart Button -->
  <div class="mt-6 pt-2">
    <button
      class="add-to-cart-btn w-full bg-transparent border-2 border-white text-white font-heading font-bold uppercase py-3 tracking-widest text-xs transition-all hover:bg-offway-blue hover:border-offway-blue hover:text-white shadow-md disabled:opacity-40 disabled:hover:bg-transparent disabled:hover:border-white/10 disabled:hover:text-white/20 disabled:cursor-not-allowed flex items-center justify-center gap-2 cursor-pointer"
      data-item-id={id}
      data-item-name={title}
      data-item-price={price}
      data-item-image={imageSrc}
      data-item-size={defaultSize}
      disabled={availableSizes.length === 0}
      data-add-btn
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
      ADD TO BAG
    </button>
  </div>
</div>

<script>
  // Add interactive JavaScript for size chip clicks inside components
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('[data-product-card]');

    cards.forEach(card => {
      const sizeButtons = card.querySelectorAll('[data-size]');
      const addBtn = card.querySelector('[data-add-btn]') as HTMLButtonElement;
      let currentSize = addBtn ? addBtn.getAttribute('data-item-size') || '' : '';

      sizeButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const selectedSize = target.getAttribute('data-size');

          // Remove selected class from all sibling buttons in this card
          sizeButtons.forEach(sb => {
            sb.classList.remove('border-offway-blue', 'bg-offway-blue', 'text-white', 'shadow-[0_0_10px_rgba(0,71,205,0.4)]');
            sb.classList.add('border-white/10', 'text-white/80');
          });

          // Add selected class to current button
          target.classList.remove('border-white/10', 'text-white/80');
          target.classList.add('border-offway-blue', 'bg-offway-blue', 'text-white', 'shadow-[0_0_10px_rgba(0,71,205,0.4)]');

          if (selectedSize) {
            currentSize = selectedSize;
            if (addBtn) addBtn.setAttribute('data-item-size', selectedSize);
          }
        });
      });

      // Lightbox triggers
      const lightboxTriggers = card.querySelectorAll('[data-lightbox-trigger]');
      lightboxTriggers.forEach(trigger => {
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          try {
            const images = JSON.parse(trigger.getAttribute('data-images') || '[]');
            window.dispatchEvent(new CustomEvent('open-lightbox', {
              detail: { images, startIndex: 0 }
            }));
          } catch (err) {
            console.error('Failed to parse lightbox images', err);
          }
        });
      });

      if (addBtn) {
        addBtn.addEventListener('click', () => {
          const id = addBtn.getAttribute('data-item-id');
          const title = addBtn.getAttribute('data-item-name');
          const price = parseFloat(addBtn.getAttribute('data-item-price') || '0');
          const imageSrc = addBtn.getAttribute('data-item-image') || '';
          const size = addBtn.getAttribute('data-item-size') || currentSize || 'ONE SIZE';

          const OffwayCart = (window as any).OffwayCart;
          if (OffwayCart && id && title) {
            OffwayCart.addItem({
              id,
              title,
              price,
              imageSrc,
              size
            });
          }
        });
      }
    });
  });
</script>
