---

<div id="whatsapp-widget" class="fixed bottom-6 right-6 z-50 flex flex-col items-end">
  
  <!-- Popup Modal -->
  <div id="wa-popup" class="hidden mb-4 w-80 sm:w-96 bg-offway-black border border-white/10 shadow-2xl rounded-2xl overflow-hidden transition-all duration-300 origin-bottom-right transform scale-95 opacity-0">
    
    <!-- Header -->
    <div class="bg-black p-6 relative border-b border-white/5">
      <button id="wa-close" class="absolute top-4 right-4 text-white/50 hover:text-white bg-white/5 hover:bg-white/20 rounded-full p-1.5 transition-colors focus:outline-none">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
      
      <div class="flex items-center space-x-2 mb-4">
        <img src="/images/logo.jpg" alt="OFF WAY" class="w-8 h-8 rounded-full border border-offway-blue object-cover" />
        <span class="font-heading font-extrabold text-lg tracking-wider text-white">OFF <span class="text-offway-blue">WAY</span></span>
      </div>
      
      <h3 class="text-xl font-bold text-white mb-2">Hey there 👋</h3>
      <p class="text-sm text-white/70 leading-relaxed font-medium">
        Welcome! Track your order status or contact us for support.
      </p>
    </div>

    <!-- Body -->
    <div class="p-6 bg-offway-card">
      
      <!-- Order Tracking -->
      <div class="mb-6">
        <label class="block text-sm font-semibold text-white/80 mb-2">Manage your orders</label>
        <input id="wa-track-input" type="text" placeholder="Enter Phone Number / Email" class="w-full bg-black border border-white/10 px-4 py-3 text-sm text-white font-mono rounded-lg placeholder-white/30 focus:outline-none focus:border-offway-blue focus:ring-1 focus:ring-offway-blue transition-all mb-3" />
        <button id="wa-track-btn" class="w-full bg-white text-black font-extrabold py-3 rounded-lg hover:bg-offway-blue hover:text-white transition-colors duration-200 uppercase tracking-widest text-xs cursor-pointer">
          SEND OTP
        </button>
      </div>

      <!-- Divider -->
      <div class="relative flex items-center py-2 mb-6">
        <div class="flex-grow border-t border-white/5"></div>
        <span class="flex-shrink-0 mx-4 text-white/20 text-[10px] uppercase font-bold tracking-widest">OR</span>
        <div class="flex-grow border-t border-white/5"></div>
      </div>

      <!-- Direct WA Chat -->
      <a href="https://wa.me/918714415090" target="_blank" rel="noopener noreferrer" class="w-full flex items-center justify-center space-x-2 bg-transparent border border-white/20 text-white font-semibold py-3 rounded-lg hover:border-[#25D366] hover:text-[#25D366] hover:bg-[#25D366]/10 transition-colors duration-200 mb-6 group">
        <svg class="w-5 h-5 text-[#25D366] group-hover:scale-110 transition-transform duration-300" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        <span>Chat with us on Whatsapp</span>
      </a>

      <!-- Help Centre -->
      <div class="">
        <label class="block text-sm font-semibold text-white/80 mb-2">Help Centre</label>
        <div class="relative">
          <input type="text" placeholder="Search articles, keywords, etc." class="w-full bg-black border border-white/10 px-4 py-3 text-sm text-white rounded-lg placeholder-white/30 focus:outline-none focus:border-offway-blue focus:ring-1 focus:ring-offway-blue transition-all pl-10" />
          <svg class="w-4 h-4 absolute left-4 top-3.5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
      </div>

    </div>
  </div>

  <!-- Floating Toggle Button -->
  <button id="wa-toggle" class="bg-black hover:bg-offway-black text-white p-4 rounded-full shadow-[0_0_20px_rgba(255,255,255,0.05)] border border-white/10 hover:border-white/30 transition-all duration-300 group z-50 focus:outline-none">
    <svg class="w-7 h-7 group-hover:scale-110 transition-transform duration-300" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
  </button>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('wa-toggle');
    const closeBtn = document.getElementById('wa-close');
    const popup = document.getElementById('wa-popup');
    const trackBtn = document.getElementById('wa-track-btn');
    const trackInput = document.getElementById('wa-track-input') as HTMLInputElement;

    function togglePopup() {
      if (popup.classList.contains('hidden')) {
        // Open popup
        popup.classList.remove('hidden');
        // A slight delay is needed for CSS transitions to work after removing display:none
        setTimeout(() => {
          popup.classList.remove('scale-95', 'opacity-0');
          popup.classList.add('scale-100', 'opacity-100');
        }, 10);
      } else {
        // Close popup
        popup.classList.remove('scale-100', 'opacity-100');
        popup.classList.add('scale-95', 'opacity-0');
        // Wait for transition to finish before hiding
        setTimeout(() => {
          popup.classList.add('hidden');
        }, 300);
      }
    }

    function handleOrderTracking() {
      if (trackInput) {
        const val = trackInput.value.trim();
        const userInput = val || "8714415090";
        const message = `Hi OFF-WAY! I want to check my order status for phone: ${userInput}`;
        const waUrl = `https://wa.me/918714415090?text=${encodeURIComponent(message)}`;
        window.open(waUrl, '_blank');
      }
    }

    if (toggleBtn) toggleBtn.addEventListener('click', togglePopup);
    if (closeBtn) closeBtn.addEventListener('click', togglePopup);
    if (trackBtn) trackBtn.addEventListener('click', handleOrderTracking);
    if (trackInput) {
      trackInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          handleOrderTracking();
        }
      });
    }
  });
</script>
